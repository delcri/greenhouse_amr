      <name>column_6</name>
      <pose>6.000 -4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_7</name>
      <pose>-6.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_8</name>
      <pose>-4.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_9</name>
      <pose>-2.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_10</name>
      <pose>0.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_11</name>
      <pose>2.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_12</name>
      <pose>4.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_13</name>
      <pose>6.000 4.880 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://support_column</uri>
      <name>column_14</name>

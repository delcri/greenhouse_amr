<?xml version="1.0"?>
<sdf version="1.9">
  <model name="dock_target">
    <static>true</static>
    <link name="plate_link">
      <visual name="plate_visual">
        <geometry>
          <box>
            <size>0.01 0.16 0.16</size>
          </box>
        </geometry>
        <material>
          <!-- Bright, saturated safety-orange: easy to threshold in HSV,
               well separated from the robot's green chassis, the brown
               table, the green plant row and the grey floor/walls. -->
          <ambient>0.95 0.35 0.02 1</ambient>
          <diffuse>0.95 0.35 0.02 1</diffuse>
        </material>
      </visual>
      <collision name="plate_collision">
        <geometry>
          <box>
            <size>0.01 0.16 0.16</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

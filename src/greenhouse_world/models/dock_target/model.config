<?xml version="1.0"?>
<model>
  <name>dock_target</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>delcri</name>
    <email>delcast2210@gmail.com</email>
  </author>
  <description>Distinctive-color flat target mounted on a grow table's aisle-facing edge. No coded ID -- greenhouse_vision detects it generically (color/contour + per-point depth), the same way the vision pipeline doesn't need to decode which pallet it's looking at either; which table it is comes from route_manager's waypoint context, not from the vision signal.</description>
</model>

<?xml version="1.0"?>
<model>
  <name>wall_segment</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>delcri</name>
    <email>delcast2210@gmail.com</email>
  </author>
  <description>2m modular greenhouse wall panel. Visual variety comes from stacked geometry (kick-plate band, raised accent stripe, corner bolts) rather than an image texture -- gz-sim's PBR albedo_map renders solid black in this Gazebo Fortress build (confirmed in isolated test worlds), so real 3D relief stands in for what a texture would normally provide, and gives RTAB-Map genuine depth-edge features besides. Repeated along the perimeter to build walls of any length.</description>
</model>

<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wall_segment">
    <static>true</static>
    <link name="panel_link">
      <!-- Main panel -->
      <visual name="panel_visual">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>2.0 0.1 1.2</size></box></geometry>
        <material>
          <ambient>0.82 0.82 0.84 1</ambient>
          <diffuse>0.82 0.82 0.84 1</diffuse>
        </material>
      </visual>
      <collision name="panel_collision">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>2.0 0.1 1.2</size></box></geometry>
      </collision>

      <!-- Darker kick-plate band at the base: a real color seam, not a
           texture image (see model.config for why: gz-sim's PBR
           albedo_map renders solid black in this Gazebo Fortress build,
           confirmed in isolated test worlds across metal/specular
           workflows, RGB/grayscale, with/without scene ambient, so
           visual variety here comes from stacked geometry instead). -->
      <visual name="kickplate_visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>2.0 0.1 0.2</size></box></geometry>
        <material>
          <ambient>0.45 0.45 0.48 1</ambient>
          <diffuse>0.45 0.45 0.48 1</diffuse>
        </material>
      </visual>

      <!-- Safety-green accent stripe, physically raised 1cm off the panel
           face (not just a color patch) so it's a real depth/geometric
           edge for RTAB-Map, not only a visual one. -->
      <visual name="accent_stripe_visual">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><box><size>2.0 0.12 0.08</size></box></geometry>
        <material>
          <ambient>0.15 0.45 0.2 1</ambient>
          <diffuse>0.15 0.45 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Corner bolts: small raised blocks at the panel's four corners,
           deliberately asymmetric-looking real 3D corner features, the
           kind of thing ORB/GFTT keypoint detectors key on well. -->
      <visual name="bolt_tl_visual">
        <pose>-0.9 0 1.05 0 0 0</pose>
        <geometry><box><size>0.05 0.13 0.05</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="bolt_tr_visual">
        <pose>0.9 0 1.05 0 0 0</pose>
        <geometry><box><size>0.05 0.13 0.05</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="bolt_bl_visual">
        <pose>-0.9 0 0.25 0 0 0</pose>
        <geometry><box><size>0.05 0.13 0.05</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="bolt_br_visual">
        <pose>0.9 0 0.25 0 0 0</pose>
        <geometry><box><size>0.05 0.13 0.05</size></box></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>greenhouse_vslam</name>
  <version>0.1.0</version>
  <description>RTAB-Map visual SLAM off the RGB-D mast camera -- localization and mapping without a lidar, same sensing approach as the forklift project</description>
  <maintainer email="delcast2210@gmail.com">delcri</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
